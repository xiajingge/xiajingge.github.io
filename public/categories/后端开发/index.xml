    <item>
      <title>Go 并发控制：sync.Pool</title>
      <link>http://localhost:1313/go/go%E5%B9%B6%E5%8F%91%E6%8E%A7%E5%88%B6sync.pool/</link>
      <pubDate>Thu, 12 Jun 2025 13:43:52 +0800</pubDate>
